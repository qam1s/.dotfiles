[
  {
    "context": "Editor || Workspace",
    "bindings": {
      "ctrl-e": "project_panel::ToggleFocus",
      "ctrl-@": "terminal_panel::Toggle",
      "ctrl-^": "workspace::NewTerminal",
      "ctrl-b": "git::Branch",
      "alt-a": "workspace::ToggleRightDock",
    },
  },
  {
    "context": "Editor",
    "bindings": {
      "ctrl-m": "editor::GoToDiagnostic",
      "ctrl-y": "editor::GoToDefinition",
      "ctrl-r": ["task::Spawn", { "task_name": "Run file" }],
      "ctrl-shift-g": "go_to_line::Toggle",
    },
  },
  {
    "context": "ProjectPanel",
    "bindings": {
      "enter": "project_panel::OpenPermanent",
      "ctrl-r": "project_panel::Rename",
    },
  },
  {
    "context": "Terminal",
    "bindings": {
      "ctrl-v": "terminal::Paste",
      "ctrl-z": ["terminal::SendKeystroke", "ctrl-c"],
      "ctrl-w": "pane::CloseActiveItem",
      "pageup": "terminal::ScrollPageUp",
      "pagedown": "terminal::ScrollPageDown",
      "shift-pageup": ["terminal::SendText", "\u001b[5;2~"],
      "shift-pagedown": ["terminal::SendText", "\u001b[6;2~"],
      "shift-home": ["terminal::SendText", "\u001b[1;2H"],
      "shift-end": ["terminal::SendText", "\u001b[1;2F"],
      "ctrl-shift-left": ["terminal::SendText", "\u001b[1;6D"],
      "ctrl-shift-right": ["terminal::SendText", "\u001b[1;6C"],
    },
  },
  {
    "context": "!Terminal",
    "bindings": {
      "ctrl-o": "projects::OpenRecent",
      "ctrl-p": "file_finder::Toggle",
    },
  },
  {
    "context": "!GitPanel",
    "bindings": {
      "ctrl-g": "git_panel::ToggleFocus",
    },
  },
]

{
  "theme": "Custom",
  "buffer_font_family": "JetBrainsMonoNL Nerd Font",
  "buffer_font_size": 20,
  "ui_font_size": 17,
  "buffer_line_height": { "custom": 1 },
  "tab_bar": { "show": false },
  "tabs": { "file_icons": true, "git_status": true, "show_diagnostics": "all" },
  "toolbar": { "breadcrumbs": true, "quick_actions": false },
  "status_bar": { "experimental.show": false },
  "project_panel": {
    "dock": "left",
    "bold_folder_labels": true,
    "indent_size": 10,
    "entry_spacing": "standard",
  },
  "git_panel": { "tree_view": true, "dock": "left", "default_width": 240 },
  "terminal": {
    "font_size": 17,
    "cursor_shape": "bar",
    "default_height": 732,
    "copy_on_select": true,
  },
  "bottom_dock_layout": "full",
  "gutter": {
    "line_numbers": false,
    "runnables": false,
    "breakpoints": false,
    "folds": false,
    "bookmarks": false,
  },
  "scrollbar": { "axes": { "horizontal": false } },
  "scroll_beyond_last_line": "off",
  "inline_code_actions": false,
  "unstable.ui_density": "compact",
  "markdown_preview": { "limit_content_width": false },
  "agent": {
    "dock": "right",
    "flexible": false,
    "default_width": 999999,
    "terminal_init_command": "opencode",
    "default_model": { "provider": "opencode", "model": "go/deepseek-flash" },
  },
  "edit_predictions": { "mode": "subtle", "provider": "codestral" },
  "telemetry": { "diagnostics": false, "metrics": false },
  "file_scan_exclusions": [
    "**/__pycache__",
    "**/.pytest_cache",
    "**/.git",
    "**/.ruff_cache",
  ],
  "autosave": "on_focus_change",
  "format_on_save": "on",
  "languages": {
    "Rust": { "language_servers": [] },
    "Python": {
      "language_servers": ["ruff", "ty"],
      "formatter": [
        { "language_server": { "name": "ruff" } },
        { "code_action": "source.organizeImports.ruff" },
        { "code_action": "source.fixAll.ruff" },
      ],
    },
  },
}

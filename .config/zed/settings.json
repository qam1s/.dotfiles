{
  "theme": {
    "mode": "dark",
    "light": "Catppuccin Frappé - No Italics",
    "dark": "Catppuccin Macchiato - No Italics",
  },
  "buffer_font_size": 21,
  "ui_font_size": 17,
  "buffer_line_height": { "custom": 1 },
  "tab_bar": { "show": false },
  "toolbar": { "breadcrumbs": true, "quick_actions": false },
  "status_bar": { "experimental.show": false },
  "tabs": { "file_icons": true, "git_status": true, "show_diagnostics": "all" },
  "project_panel": {
    "dock": "left",
    "bold_folder_labels": true,
    "indent_size": 10,
    "entry_spacing": "standard",
    "default_width": 200,
  },
  "git_panel": { "tree_view": true, "dock": "left", "default_width": 200 },
  "outline_panel": { "button": false },
  "collaboration_panel": { "button": false },
  "terminal": { "font_size": 16, "default_height": 732 },
  "bottom_dock_layout": "full",
  "gutter": {
    "line_numbers": false,
    "runnables": false,
    "breakpoints": false,
    "folds": false,
    "bookmarks": false,
  },
  "scrollbar": { "axes": { "horizontal": false } },
  "inline_code_actions": false,
  "unstable.ui_density": "compact",
  "window_decorations": "server",
  "agent": {
    "dock": "right",
    "tool_permissions": { "default": "allow" },
    "default_model": {
      "enable_thinking": false,
      "effort": "low",
      "provider": "opencode",
      "model": "go/mimo-v2.5",
    },
  },
  "edit_predictions": { "mode": "subtle", "provider": "codestral" },
  "telemetry": { "diagnostics": false, "metrics": false },
  "file_scan_exclusions": [
    "**/__pycache__",
    "**/.pytest_cache",
    "**/.git",
    "**/.ruff_cache",
  ],
  "autosave": "on_focus_change",
  "format_on_save": "on",
  "languages": {
    "Python": {
      "language_servers": ["ruff", "ty"],
      "formatter": [
        { "language_server": { "name": "ruff" } },
        { "code_action": "source.organizeImports.ruff" },
        { "code_action": "source.fixAll.ruff" },
      ],
    },
  },
}

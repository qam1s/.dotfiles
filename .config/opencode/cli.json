{
  "theme": { "name": "catppuccin-macchiato" },
  "session": { "sidebar": "hide", "tps": false },
  "tabs": { "mode": "off" },
  "prompt": { "editor": false },
  "cursor": { "style": "default" },
  "animations": false,
  "attention": { "sound": true, "volume": 1 },
  "keybinds": {
    "session.new": "ctrl+a",
    "session.list": "ctrl+o",
    "session.first": "shift+pageup",
    "session.last": "shift+pagedown",
    "input.line.home": "ctrl+a,home",
    "input.line.end": "ctrl+e,end"
  }
}

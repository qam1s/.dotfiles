{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "catppuccin-macchiato"
  },
  "session": {
    "sidebar": "hide",
    "tps": false
  },
  "tabs": {
    "mode": "off"
  },
  "prompt": {
    "editor": false
  },
  "cursor": {
    "style": "default"
  },
  "keybinds": {
    "session.new": "ctrl+a",
    "session.list": "ctrl+o",
    "diff.open": "ctrl+d"
  },
  "animations": false,
  "attention": {
    "sound": true,
    "volume": 0.5
  }
}
